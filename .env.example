# Copy this file to .env and fill in your own values.
# .env is gitignored; this template is safe to commit.

APP_NAME=RTF-Location

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

ALGORITHM=HS256

# Token lifetime in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=sqlite:///./rtf_location.db

# Optional: Cloudinary avatar CDN
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=

# Optional: comma-separated allowed origins if the frontend is hosted elsewhere
# CORS_ORIGINS=http://localhost:3000

# Raw location history retention in days (0 disables pruning)
LOCATION_RETENTION_DAYS=90

# Optional: Twilio SOS SMS escalation
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+12025550123
